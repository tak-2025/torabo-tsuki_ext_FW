menuconfig ZMK_DYNAMIC_COMBOS
    bool "Dynamic (NVS-backed, live-editable) combos for torabo-tsuki"
    help
      Runtime-editable combos: a set of key positions pressed together fires one
      behavior (key press / layer / dynamic macro). Definitions live in NVS and
      are edited live over BLE, so changing a combo never needs a reflash.

      This replaces the upstream (devicetree-const) combo engine with a literal
      copy whose definition array is RAM-backed. It is the SINGLE owner of the
      position-combo listener: do NOT also instantiate a "zmk,combos" node
      (the upstream combo.c stays inert when that node is absent). Fail-safe:
      empty/invalid/disabled combos never capture a key, so normal typing is
      unaffected.

if ZMK_DYNAMIC_COMBOS

module = ZMK_DYNAMIC_COMBOS

# BLE detail (was CONFIG_ZMK_DYNAMIC_COMBOS_BLE's own help; kept here since
# Kconfig help text can't take a $(var) — see
# features/common/Kconfig.template.torabo_ble):
#   Custom encrypted GATT service: READ returns all combo slots (Read Blob),
#   WRITE updates one combo at a time (small enough to fit a single ATT write,
#   so no long-write is needed).
torabo-thing = "dynamic-combo config"
rsource "../common/Kconfig.template.torabo_ble"

# TUNNEL detail (was CONFIG_ZMK_DYNAMIC_COMBOS_TUNNEL's own help tail):
#   Carries the exact same READ/WRITE wire blobs as the GATT service (feature
#   id 0x0B), and coexists with it.
torabo-thing = "the dynamic-combo config"
rsource "../common/Kconfig.template.torabo_tunnel"

module-str = ZMK Dynamic Combos
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_DYNAMIC_COMBOS

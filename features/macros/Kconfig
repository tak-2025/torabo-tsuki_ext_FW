menuconfig ZMK_DYNAMIC_KEYMAP
    bool "Dynamic (NVS-backed, live-editable) macros for torabo-tsuki"
    help
      Runtime-editable macros invoked via &dmac <slot>. The slot contents are
      stored in NVS and edited live over BLE, so changing a macro never needs a
      reflash. Fail-safe: empty/invalid slots simply do nothing. Phase 1 =
      macros; combos are a planned Phase 2 in the same module.

if ZMK_DYNAMIC_KEYMAP

module = ZMK_DYNAMIC_KEYMAP

# BLE detail (was CONFIG_ZMK_DYNAMIC_KEYMAP_BLE's own help; kept here since
# Kconfig help text can't take a $(var) — see
# features/common/Kconfig.template.torabo_ble):
#   Custom encrypted GATT service: READ returns all macro slots (Read Blob),
#   WRITE updates one slot at a time (small enough to fit a single ATT write,
#   so no long-write is needed).
torabo-thing = "dynamic-keymap config"
rsource "../common/Kconfig.template.torabo_ble"

# TUNNEL detail (was CONFIG_ZMK_DYNAMIC_KEYMAP_TUNNEL's own help tail):
#   Carries the exact same READ/WRITE wire blobs as the GATT service (feature
#   id 0x0A), and coexists with it.
torabo-thing = "the dynamic-keymap config"
rsource "../common/Kconfig.template.torabo_tunnel"

config ZMK_DYNAMIC_KEYMAP_STEP_TAP_MS
    int "Per-step tap duration (ms) for TAP steps"
    default 2

config ZMK_DYNAMIC_KEYMAP_STEP_GAP_MS
    int "Inter-step gap (ms)"
    default 2

module-str = ZMK Dynamic Keymap
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_DYNAMIC_KEYMAP

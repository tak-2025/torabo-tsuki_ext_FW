menuconfig TORABO_CAPS
    bool "Torabo capability descriptor (firmware self-description)"
    default n
    help
      Expose "what can this firmware do?" to Torabo-Studio: the firmware version,
      which feature modules were compiled in, each one's wire version, and
      per-feature capability bits.

      A build is assembled from snippets, so two keyboards running the same app can
      have completely different feature sets. Rather than have the app guess (or
      probe every GATT service and see which ones fail), the firmware names itself
      once on connect and the app shows only the tabs that exist.

      Enable on the CENTRAL — it is the half the app talks to.

if TORABO_CAPS

module = TORABO_CAPS

# BLE detail (was CONFIG_TORABO_CAPS_BLE's own help; kept here since Kconfig
# help text can't take a $(var) — see features/common/Kconfig.template.torabo_ble):
#   Read-only GATT service e1f4a000. Nothing to write: it describes the build.
torabo-thing = "the descriptor"
rsource "../common/Kconfig.template.torabo_ble"

# TUNNEL detail (was CONFIG_TORABO_CAPS_TUNNEL's own help in full — this one
# never fit the other 7 features' shared "Register the settings..." shape):
#   Same read-only descriptor as the GATT service (feature id 0x00), reachable
#   over whichever transport Studio RPC is using. This is how a USB-connected
#   app discovers that the tunnel exists at all, so keep it on wherever the
#   tunnel is on: the descriptor gains an RpcTunnel entry when it is.
torabo-thing = "the descriptor"
rsource "../common/Kconfig.template.torabo_tunnel"

config TORABO_FW_VERSION_MAJOR
    int "Torabo firmware version: major"
    default 0

config TORABO_FW_VERSION_MINOR
    int "Torabo firmware version: minor"
    default 1

config TORABO_FW_VERSION_PATCH
    int "Torabo firmware version: patch"
    default 0

module-str = Torabo Caps
source "subsys/logging/Kconfig.template.log_config"

endif # TORABO_CAPS

# Torabo ZMK features (companion firmware module for Torabo-Studio).
#
# Independent features, each opt-in via its own CONFIG so a build target enables
# only what it needs:
#
#   CONFIG_ZMK_DYNAMIC_KEYMAP=y      -> custom macros (&dmac, live BLE edit)
#   CONFIG_ZMK_DYNAMIC_COMBOS=y      -> live-editable combos (NVS-backed engine)
#   CONFIG_ZMK_TRACKBALL_CONFIG=y    -> trackball settings + auto mouse (temp) layer
#   CONFIG_TORABO_RESERVED_LAYERS=N  -> inject N reserved layers (with the
#                                       torabo-reserved-layers snippet)
#   CONFIG_ZMK_TIMING_CONFIG=y       -> runtime hold-tap (&mt/&lt) + kscan
#                                       debounce timing (CENTRAL)
#   CONFIG_ZMK_TIMING_SPLIT_PERIPHERAL=y
#                                    -> receive the debounce windows the central
#                                       pushes over the split link (PERIPHERAL)
#
# All default off; the parent ZMK config turns on what it wants per shield.

rsource "features/macros/Kconfig"
rsource "features/combos/Kconfig"
rsource "features/trackball/Kconfig"
rsource "features/trackpad/Kconfig"
rsource "features/layers/Kconfig"
rsource "features/encoder/Kconfig"
rsource "features/caps/Kconfig"
rsource "features/led/Kconfig"
rsource "features/live_feed/Kconfig"
rsource "features/timing/Kconfig"
